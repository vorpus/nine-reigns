      "weight": 0,
      "noTime": true,
      "when": [{ "meta": "secondCat" }],
      "ui": { "entry": true },
      "left": { "label": "Yes", "next": "tut_curse_kidding" },
      "right": { "label": "I'm not sure...", "next": "tut_curse_kidding" }
    },
