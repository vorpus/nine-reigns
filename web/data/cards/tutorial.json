      "bag": "chain",
      "weight": 0,
      "left": { "label": "Respect Gerald", "fx": { "instinct": 5 }, "next": "tut_one_scoop" },
      "right": { "label": "Chew Gerald", "fx": { "instinct": -10, "home": -5, "belly": 5 }, "set": { "plants_eaten": "+1" }, "next": "tut_one_scoop" }
