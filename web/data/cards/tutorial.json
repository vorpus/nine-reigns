      "char": "instinct",
      "text": "THE GLASS OF WATER ON THE TABLE. IT IS LOOKING AT US.",
      "bag": "chain",
      "weight": 0,
      "left": { "label": "Let it live", "fx": { "instinct": 10 } },
      "right": { "label": "Knock it off", "fx": { "instinct": -15, "home": -10, "joy": -5 }, "set": { "knocked": "+1" } }
    },

    {
